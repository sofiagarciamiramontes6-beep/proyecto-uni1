def colocar_palabra(tablero, palabra, fila, col, ori):
    longi2=len(palabra)
    if ori == "H":
        for i in range(longi2):
            tablero[fila][col + i]=palabra[i]

    elif ori == "V":
        for i in range(longi2):
            tablero[fila + i][col]=palabra[i]



