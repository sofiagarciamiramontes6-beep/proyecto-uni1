from numpy import *


fil=12
colu=18

def crearTab():
    tablero = []
    for f in range(fil):
        fila = []
        for c in range(colu):
            fila.append(" ")
        tablero.append(fila)
    return tablero


def equisGuia():
    guia = []
    for f in range(fil):
        fila = []
        for c in range(colu):
            fila.append("_")  
        guia.append(fila)
    return guia


def letrAs(guia, palabra, fila, col, ori):
    if ori=="H":
        for i in range(len(palabra)):
            guia[fila][col+i]=("X")
    if ori=="V":
        for i in range(len(palabra)):
            guia[fila + i][col]=("X")

        
